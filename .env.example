# Copy to .env to override defaults. Never commit .env.
# PORT=8765                 # game + AI hub (bound to 127.0.0.1)
# TTS_PORT=8766             # voice service
# LLM_PORT=8000             # vLLM
# LLM_URL=http://127.0.0.1:8000        # any OpenAI-compatible server
# LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
# VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05.post1-py3
# VLLM_GPU_MEM=0.4          # share of unified memory vLLM may reserve
# HF_CACHE=~/.cache/huggingface
# HF_TOKEN=                 # only needed for gated models; keep it in .env, never in git
# BIND_HOST=127.0.0.1       # keep localhost; reach the game through an SSH tunnel
